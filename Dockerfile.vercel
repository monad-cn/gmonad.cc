# syntax=docker/dockerfile:1
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS dependencies
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN node scripts/build-container.mjs

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/src/docs ./src/docs
COPY --from=builder --chown=node:node /app/scripts/check-runtime.mjs ./scripts/check-runtime.mjs
COPY --from=builder --chown=node:node /app/src/server/runtime-policy.mjs ./src/server/runtime-policy.mjs
RUN rm -rf .next/cache && ln -s /tmp/gmonad-next-cache .next/cache
USER node
EXPOSE 3000
CMD ["sh", "-c", "mkdir -p /tmp/gmonad-next-cache && node scripts/check-runtime.mjs && exec node server.js"]
